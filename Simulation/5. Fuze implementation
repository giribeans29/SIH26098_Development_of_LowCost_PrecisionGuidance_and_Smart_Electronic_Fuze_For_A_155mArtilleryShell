// ============================================================
// KEYBOARD
// ============================================================

void keyPressed() {

  // R = RESET

  if (
    key == 'r' ||
    key == 'R'
  ) {

    startSimulation();
  }


  // SPACE = PAUSE

  else if (
    key == ' '
  ) {

    if (!paused) {

      paused = true;

      pauseStartMillis =
        millis();
    }

    else {

      paused = false;

      totalPausedMillis +=
        millis() -
        pauseStartMillis;
    }
  }
}
