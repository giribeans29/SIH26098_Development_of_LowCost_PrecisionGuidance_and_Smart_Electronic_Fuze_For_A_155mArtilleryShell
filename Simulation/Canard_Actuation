  );


  text(
    "Desired Pitch: " +
    nf(
      desiredPitch,
      0,
      2
    ) +
    "°",
    panelX + 20,
    panelY + 225
  );


  text(
    "Desired Roll: " +
    nf(
      desiredRoll,
      0,
      2
    ) +
    "°",
    panelX + 20,
    panelY + 250
  );


  // ----------------------------------------------------------
  // SERIAL
  // ----------------------------------------------------------

  fill(180);


  text(
    "Port: " +
    serialPortName,
    panelX + 20,
    panelY + 285
  );


  text(
    "Status: " +
    (
      serialEnabled
      ?
      "CONNECTED"
      :
      "DISCONNECTED"
    ),
    panelX + 20,
    panelY + 310
  );


  fill(120);


  text(
    "R = Reset",
    panelX + 20,
    panelY + 340
  );
}


// ============================================================
// KEYBOARD
// ============================================================

void keyPressed() {

  if (
    key == 'r' ||
    key == 'R'
  ) {

    resetSimulation();
  }


  else if (
    key == ' '
  ) {

    if (!isPaused) {

      isPaused = true;

      pauseStartMillis =
        millis();
    }

    else {

      isPaused = false;

      totalPausedMillis +=
        millis()
        -
        pauseStartMillis;
    }
  }
}
